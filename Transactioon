create table tblArveldusarve (
    KontoId INT NOT NULL PRIMARY KEY,
    KliendiNr INT,
    Omanik NVARCHAR(30),
    Saldo DECIMAL(10,2) CHECK (Saldo >= 0)
);

create table tblHoiusarve (
    KontoId INT NOT NULL PRIMARY KEY,
    KliendiNr INT,
    Omanik NVARCHAR(30),
    Saldo DECIMAL(10,2) CHECK (Saldo >= 0)
);

