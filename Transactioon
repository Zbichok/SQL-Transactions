create procedure spUlekanne
as
begin
    begin try
        begin transaction;

        update tblHoiusarve
        set Saldo = Saldo + 200
        where KliendiNr = 201;

        update tblArveldusarve
        set Saldo = Saldo - 200
        where KliendiNr = 201;

        commit transaction;
    end try

    begin catch
        rollback transaction;
    end catch
end;

exec spUlekanne;
